# Neon Postgres (med PostGIS).
# Använd gärna Neons "pooled connection"-sträng (värdnamn med -pooler)
# eftersom backend körs serverless på Vercel.
DATABASE_URL="NICK HAR DENNA OCKSÅ"

# Kommaseparerad lista över tillåtna frontend-URL:er (CORS)
CORS_ORIGINS=http://localhost:5173

# S3-kompatibel Bucket i Neon. Behövs för profilbildslagring.

S3_BUCKET="profilepics"
AWS_ENDPOINT_URL_S3="https://br-morning-thunder-b1dqr2ag.storage.c-5.eu-central-1.aws.neon.tech"
AWS_ACCESS_KEY_ID="NICK HAR DENNA"
AWS_SECRET_ACCESS_KEY="NICK HAR DENNA"
AWS_REGION="eu-central-1"

# Lösenords tokens för inloggnings systemet
JWT_SECRET="generera med secrets.token_urlsafe(48)"

# AI som läser ut intressen ur profiltexten i intervjun. Tomma = funktionen är avstängd.
OPENAI_API_KEY=
OPENAI_MODEL=
# Skicka följdfrågor när AI:n är osäker? 0 = av (analysen gissar aldrig en aktivitet), 1 = på.
INTEREST_FOLLOWUPS=0

# Mejl från appen (bekräftelse av e-post) via Resend. Tom nyckel = inga mejl skickas, de skrivs i
# terminalen i stället, så att länkarna går att testa lokalt.
RESEND_API_KEY=
EMAIL_FROM="Intresseklubben <noreply@intresse-klubben.se>"
# Frontendens adress, för länkarna i mejlen. Tom = första adressen i CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173
# Måste e-posten vara bekräftad för att logga in? 0 = nej (tills vidare), 1 = ja.
REQUIRE_EMAIL_VERIFICATION=0

#Styr hur kreativ och varierad LLM får vara när den läser in intressetaggar (vi vill inte ha den särskilt kreativ)
OPENAI_TEMPERATURE=0

MODERATION_SPACE=
HF_TOKEN=